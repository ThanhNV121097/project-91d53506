# Injected by the runtime — read it, do not assemble a DSN from DB_* parts.
DATABASE_URL=postgres://app:app_secret@localhost:5432/app?sslmode=disable
# Injected by the runtime; falls back to APP_PORT then 8080 if unset.
PORT=8080

# Agent Team inbox the contact form forwards to (contact module,
# CONTACT-001). Already configured at the platform level — the backend's
# own copy of the same key/endpoint code/frontend/src/site.json carries; no
# new secret requested here.
AGENT_TEAM_API_URL=
AGENT_TEAM_KEY=

# VNPay merchant terminal code (payments module, PAYMENTS-001).
VNPAY_TMN_CODE=
# VNPay callback/signature secret — server-side only, never logged.
VNPAY_HASH_SECRET=

# Google OAuth client for Google sign-in (auth module, AUTH-003).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SMS provider key for phone+OTP sign-in (auth module, AUTH-002).
SMS_OTP_API_KEY=

# Outbound email for booking/approval notifications (notifications module, NOTIF-001).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# Zalo OA channel for booking/approval notifications (notifications module, NOTIF-001).
ZALO_OA_API_KEY=

# Media storage/CDN for the shared upload endpoint (suppliers module, SUPPLIERS-006).
MEDIA_STORAGE_CLOUD_NAME=
MEDIA_STORAGE_API_KEY=
MEDIA_STORAGE_API_SECRET=
