# Injected by the runtime — read it, do not assemble a DSN from DB_* parts.
DATABASE_URL=postgres://app:app_secret@localhost:5432/app?sslmode=disable
# Injected by the runtime; falls back to APP_PORT then 8080 if unset.
PORT=8080

# VNPay merchant terminal code (payments module, PAYMENTS-001).
VNPAY_TMN_CODE=
# VNPay callback/signature secret — server-side only, never logged.
VNPAY_HASH_SECRET=

# Google OAuth client for Google sign-in (auth module, AUTH-003).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SMS provider key for phone+OTP sign-in (auth module, AUTH-002).
SMS_OTP_API_KEY=

# Outbound email for booking/approval notifications (notifications module).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Zalo OA channel for booking/approval notifications (notifications module).
ZALO_OA_API_KEY=

# Media storage/CDN for the shared upload endpoint (suppliers module, SUPPLIERS-006).
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_CDN_URL=
