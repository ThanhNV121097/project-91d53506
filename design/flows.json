[
  {
    "name": "Search for a trip",
    "steps": [
      { "action": "open", "path": "/" },
      { "action": "type", "selector": "#where", "value": "Cửa Lò" },
      { "action": "click", "selector": "[data-testid='search-submit']" },
      { "action": "expect", "selector": "[data-testid='result-count']", "text": "trips match" }
    ]
  },
  {
    "name": "Book a trip and pay",
    "auth": true,
    "steps": [
      { "action": "open", "path": "/tours/cua-lo-beach-2n1d" },
      { "action": "click", "selector": "[data-testid='book-now']" },
      { "action": "type", "selector": "#adults", "value": "2" },
      { "action": "type", "selector": "#name", "value": "Tran Lan" },
      { "action": "type", "selector": "#phone", "value": "0900000000" },
      { "action": "type", "selector": "#email", "value": "lan@example.com" },
      { "action": "click", "selector": "[data-testid='book-continue']" },
      { "action": "click", "selector": "[data-testid='pay-vnpay']" },
      { "action": "click", "selector": "[data-testid='pay-now']" },
      { "action": "expect", "selector": "[data-testid='booking-code']", "text": "NA-" }
    ]
  },
  {
    "name": "Check a booking's status",
    "auth": true,
    "steps": [
      { "action": "open", "path": "/account" },
      { "action": "expect", "selector": "[data-testid='account-bookings']", "text": "NA-" }
    ]
  },
  {
    "name": "Read a Nghệ An guide",
    "steps": [
      { "action": "open", "path": "/guides" },
      { "action": "click", "selector": "[data-testid='guide-card-0']" },
      { "action": "expect", "selector": "[data-testid='guide-body']", "text": "the" }
    ]
  },
  {
    "name": "Submit a product for approval",
    "steps": [
      { "action": "open", "path": "/signin" },
      { "action": "type", "selector": "#email", "value": "hue@cualohomestay.vn" },
      { "action": "click", "selector": "[data-testid='role-supplier']" },
      { "action": "click", "selector": "[data-testid='signin-submit']" },
      { "action": "open", "path": "/supplier/products/cua-lo-beach-2n1d" },
      { "action": "click", "selector": "[data-testid='submit-product']" },
      { "action": "expect", "selector": "[data-testid='product-saved']", "text": "admin" }
    ]
  }
]
